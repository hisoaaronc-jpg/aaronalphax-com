# 南海数港 Nanhai Digital Port — 环境变量模板
# 用法：cp .env.example .env ，把占位符换成真实值。不要把 .env 提交到任何公开仓库。
# 本文件只有占位符，没有任何真实密钥。

# ---- LiteLLM 网关自身（必填）----
# 主密钥：也是 Admin UI（http://<服务器>:4000/ui）的登录密码，用户名 admin
# 生成方法：openssl rand -hex 32
LITELLM_MASTER_KEY=sk-REPLACE-WITH-RANDOM-64-HEX
# 盐密钥：加密存入数据库的上游 API Key；设定后不可改，改了旧密钥全失效
# 生成方法：openssl rand -hex 32
LITELLM_SALT_KEY=sk-REPLACE-WITH-RANDOM-64-HEX

# ---- 数据库（必填，docker compose 内部用）----
POSTGRES_DB=litellm
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=REPLACE-WITH-STRONG-DB-PASSWORD
# Redis 缓存主机名：docker compose 内部服务名，不用改
REDIS_HOST=redis

# ---- 客户门户管理员密码（必填，上线前务必改掉）----
# 门户管理员登录用的密码；默认 changeme 时管理员登录会被拒绝
PORTAL_ADMIN_PASSWORD=REPLACE-WITH-STRONG-ADMIN-PASSWORD

# ---- 上游厂商 API Key（按需填写；不用的厂商留空即可）----
# 美国模型
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# 中国模型
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
BAIDU_API_KEY=
